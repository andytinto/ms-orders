<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- ========================= -->
  <!-- CONFIG FILES -->
  <!-- ========================= -->
  <ItemGroup>
    <None Update="appsettings*.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- ========================= -->
  <!-- PACKAGE REFERENCES (CPM) -->
  <!-- ========================= -->
  <ItemGroup>
    <!-- Logging -->
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Enrichers.Environment" />
    <PackageReference Include="Serilog.Enrichers.ClientInfo" />

    <!-- Security -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />

    <!-- Serialization / Utils -->
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="NetEscapades.Configuration.Yaml" />

    <!-- API Docs -->
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orders.Application\Orders.Application.csproj" />
    <ProjectReference Include="..\Orders.Infrastructure\Orders.Infrastructure.csproj" />
    <ProjectReference Include="..\Orders.Persistance\Orders.Persistance.csproj" />
  </ItemGroup>

</Project>
